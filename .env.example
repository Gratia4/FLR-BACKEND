NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/flr
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://flrltd-b432d.web.app
TRUST_PROXY=1
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Only needed while running `npm run create-admin`; do not retain these in Railway afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_NAME=FLR Administrator
ADMIN_PHONE=+250700000000
