# ---------------------------------------------------------------- core ----
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/flr

# ---------------------------------------------------------------- auth ----
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=60
MAX_FAILED_LOGINS=6
LOCKOUT_MINUTES=15

# ------------------------------------------------------------- network ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://flrltd-b432d.web.app,https://flrltd-b432d.firebaseapp.com
TRUST_PROXY=1
# Used to build links inside outgoing email.
PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------- documents ----
# `local` is for development only. Container filesystems are ephemeral, so
# production MUST use s3 (AWS S3, Cloudflare R2, Backblaze B2 …).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
DOCUMENT_URL_TTL_SECONDS=300
# S3_BUCKET=flr-compliance-documents
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --------------------------------------------------------------- email ----
# `console` logs messages instead of sending them — fine for development.
MAIL_DRIVER=console
# RESEND_API_KEY=
MAIL_FROM=FLR Ltd. <no-reply@flr.rw>
# Receives new-application alerts and the daily inventory digest.
# OPS_NOTIFICATION_EMAIL=operations@flr.rw

# ------------------------------------------------------------ commerce ----
DEFAULT_VAT_RATE=0.18
DEFAULT_PAYMENT_TERMS_DAYS=30
EXPIRY_ALERT_DAYS=90

# ------------------------------------------------- one-time admin setup ----
# Only needed while running `npm run create-admin`; remove afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_NAME=FLR Administrator
ADMIN_PHONE=+250700000000
